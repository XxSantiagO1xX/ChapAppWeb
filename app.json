{
  "expo": {
    "name": "ChapApp",
    "slug": "chap-app",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "scheme": "chapapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ariel.chapapp"
    },
    "android": {
      "package": "com.ariel.chapapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
