{
  "version": 2,
  "framework": null,
  "buildCommand": "echo 'Static build ready'",
  "outputDirectory": ".",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|styles/|src/|favicon.ico|manifest.json).*)",
      "destination": "/index.html"
    }
  ]
}
